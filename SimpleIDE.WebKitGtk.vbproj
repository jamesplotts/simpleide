<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    The WebKitGTK-backed IEmbeddedBrowserView provider (Widgets/CustomDrawWebView.vb) -
    full JS-capable rendering via the system's libwebkit2gtk-4.1, hand-rolled P/Invoke (see
    Interop/WebKitNative.vb's header comment for why, not the dead WebkitGtkSharp NuGet
    package). Linux-only in practice - WebKitGTK has no Windows build - but nothing here
    needs a platform guard: EmbeddedBrowserFactory (SimpleIDE.vbproj) checks
    CustomDrawWebView.IsAvailable (a runtime NativeLibrary.TryLoad probe, since this is a
    system package never bundled by this repo) before ever constructing this widget, and
    falls back to the always-available litehtml-backed CustomDrawHtmlView if it's missing.

    This is the exact seam a fork adds its own backend behind: implement
    Interfaces/IEmbeddedBrowserView (SimpleIDE.Widgets.vbproj) against WebView2/CEF in a new
    SimpleIDE.<Backend>.vbproj, add one line to EmbeddedBrowserFactory's preference order -
    nothing else in the app needs to change.
  -->
  <!-- See SimpleIDE.Widgets.vbproj's own comment on this split-import form - both .vbproj
       files sit in this same directory and would collide on a shared obj/bin without
       distinct paths, and BaseIntermediateOutputPath must be set before Sdk.props imports
       (MSB3539) or NuGet's own restore output still lands in the default shared obj/. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\WebKitGtk\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\WebKitGtk\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SimpleIDE</RootNamespace>
    <AssemblyName>SimpleIDE.WebKitGtk</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>Latest</LangVersion>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="SimpleIDE.Widgets.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Interop/WebKitNative.vb" />
    <Compile Include="Widgets/CustomDrawWebView.vb" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
